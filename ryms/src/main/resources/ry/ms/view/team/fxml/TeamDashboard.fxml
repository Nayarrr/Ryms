<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ry.ms.view.team.TeamDashboardController"
            prefHeight="600.0" prefWidth="900.0">

    <top>
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Mon Équipe" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="teamNameLabel" style="-fx-font-size: 20px; -fx-text-fill: #2196F3;"/>
                <Label fx:id="teamTagLabel" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Bouton créer une équipe (affiché seulement si pas d'équipe) -->
                <Button fx:id="createTeamButton"
                        text="+ Créer une Équipe"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;"
                        onAction="#handleCreateTeam"/>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            
            <!-- Section Membres -->
            <VBox spacing="10">
                <Label text="Membres de l'équipe" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <ListView fx:id="membersList" prefHeight="200">
                    <placeholder>
                        <Label text="Aucun membre. Créez une équipe pour commencer."/>
                    </placeholder>
                </ListView>
            </VBox>

            <!-- Section Invitation -->
            <VBox spacing="10">
                <Label text="Inviter un membre" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <TextField fx:id="inviteEmailField"
                               promptText="Email du joueur à inviter"
                               prefWidth="300"/>
                    <Button text="Envoyer l'invitation"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white;"
                            onAction="#handleInvite"/>
                </HBox>
            </VBox>

            <!-- Actions sur l'équipe -->
            <HBox spacing="10">
                <Button text="Quitter l'équipe"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white;"
                        onAction="#handleLeave"/>
                <Button text="Dissoudre l'équipe"
                        style="-fx-background-color: #f44336; -fx-text-fill: white;"
                        onAction="#handleDissolve"/>
            </HBox>

            <!-- Message -->
            <Label fx:id="msgLabel" wrapText="true" style="-fx-text-fill: #666;"/>
        </VBox>
    </center>
</BorderPane>