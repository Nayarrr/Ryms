<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ry.ms.view.team.TeamDashboardController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@../../styles.css">

    <top>
        <VBox spacing="6" styleClass="header-section">
            <padding>
                <Insets top="18" right="20" bottom="12" left="20"/>
            </padding>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Mon Équipe" styleClass="header-title"/>
                <Label fx:id="teamNameLabel" styleClass="subtitle-label" style="-fx-text-fill: #3498db;"/>
                <Label fx:id="teamTagLabel" styleClass="subtitle-label"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Bouton créer une équipe (affiché seulement si pas d'équipe) -->
                <Button fx:id="createTeamButton"
                        text="+ Créer une Équipe"
                        styleClass="button, primary-button"
                        onAction="#handleCreateTeam"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            
            <!-- Section Membres -->
            <VBox spacing="10" styleClass="card">
                <Label text="Membres de l'équipe" styleClass="title-label"/>
                <ListView fx:id="membersList" prefHeight="200" styleClass="list-view">
                    <placeholder>
                        <Label text="Aucun membre. Créez une équipe pour commencer." styleClass="placeholder-text"/>
                    </placeholder>
                </ListView>
            </VBox>

            <!-- Section Invitation -->
            <VBox spacing="10" styleClass="card">
                <Label text="Inviter un membre" styleClass="title-label"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="inviteEmailField"
                               promptText="Email du joueur à inviter"
                               prefWidth="300"
                               styleClass="text-field"/>
                    <Button text="Envoyer l'invitation"
                            styleClass="button, primary-button"
                            onAction="#handleInvite"/>
                </HBox>
            </VBox>

            <!-- Actions sur l'équipe -->
            <HBox spacing="10">
                <Button text="Quitter l'équipe"
                        styleClass="button, warning-button"
                        onAction="#handleLeave"/>
                <Button text="Dissoudre l'équipe"
                        styleClass="button, danger-button"
                        onAction="#handleDissolve"/>
            </HBox>

            <!-- Message -->
            <Label fx:id="msgLabel" wrapText="true" styleClass="subtitle-label"/>
        </VBox>
    </center>
</BorderPane>