<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="ry.ms.view.games.GameCatalogController" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f9f9f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label text="Administrator View" style="-fx-text-fill: #7f8c8d;" />
            <HBox alignment="CENTER_LEFT">
                <Label text="Liste des jeux" style="-fx-font-size: 24; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Ajouter Un jeu" fx:id="addGameBtn" onAction="#handleOpenAddGame" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-padding: 10 20;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <FlowPane fx:id="gameGrid" hgap="20" vgap="20">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>