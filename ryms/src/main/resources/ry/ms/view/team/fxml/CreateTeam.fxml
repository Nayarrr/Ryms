<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ry.ms.view.team.CreateTeamController"
      spacing="20"
      alignment="CENTER"
      prefHeight="400"
      prefWidth="500"
      stylesheets="@../../styles.css"
      styleClass="card">

    <!-- Titre -->
    <Label text="Créer une nouvelle équipe" styleClass="header-title"/>

    <Separator/>

    <!-- Formulaire -->
    <GridPane hgap="15" vgap="15" alignment="CENTER">
        <!-- Nom de l'équipe -->
        <Label text="Nom de l'équipe :" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="subtitle-label"/>
        <TextField fx:id="nameField"
                   prefWidth="300"
                   promptText="Ex: Phoenix Legends"
                   styleClass="text-field"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <!-- Tag de l'équipe -->
        <Label text="Tag (3-5 lettres) :" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="subtitle-label"/>
        <TextField fx:id="tagField"
                   prefWidth="300"
                   promptText="Ex: PHX"
                   styleClass="text-field"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <!-- Avatar URL -->
        <Label text="Avatar (URL) :" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="subtitle-label"/>
        <TextField fx:id="avatarField"
                   prefWidth="300"
                   promptText="https://... (optionnel)"
                   styleClass="text-field"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>
    </GridPane>

    <!-- Bouton de création -->
    <Button text="Créer l'équipe"
            prefWidth="200"
            styleClass="button, primary-button"
            onAction="#handleCreateTeam"/>

    <!-- Message d'erreur -->
    <Label fx:id="errorLabel" 
           wrapText="true" 
           prefWidth="400"
           styleClass="error-label"/>
</VBox>