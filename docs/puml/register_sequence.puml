@startuml
actor User
participant "RegisterView" as View
participant "RegisterController" as Controller
participant "SessionFacade" as Facade
participant "UserManager" as Manager
participant "UserDAO" as DAO
database "PostgreSQL" as DB

User -> View : Enters Details (email, user, pass)
View -> Controller : handleRegister()
activate Controller
Controller -> Facade : registerUser(email, pass, user)
activate Facade
Facade -> Manager : register(email, pass, user)
activate Manager
Manager -> DAO : findByEmail(email)
activate DAO
DAO -> DB : SELECT ...
activate DB
DB --> DAO : Result
deactivate DB
DAO --> Manager : User (or empty)
deactivate DAO

alt User already exists
    Manager --> Facade : text UserAlreadyExistsException
    Facade --> Controller : throw UserAlreadyExistsException
    Controller -> View : Show Error "Email déjà utilisé"
else New User
    Manager -> DAO : createUser(email, pass, user)
    activate DAO
    DAO -> DB : INSERT ...
    activate DB
    DB --> DAO : OK
    deactivate DB
    DAO --> Manager : New User Object
    deactivate DAO
    Manager --> Facade : User
    deactivate Manager
    Facade -> Facade : setCurrentUser(User)
    Facade --> Controller : User
    deactivate Facade
    Controller -> View : Show Success Message
    Controller -> View : Redirect to Dashboard
end
deactivate Controller
@enduml
