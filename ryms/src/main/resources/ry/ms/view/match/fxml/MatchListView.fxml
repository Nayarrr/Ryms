<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ry.ms.view.match.MatchListViewController"
      spacing="20"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="📋 Gestion des Matchs" 
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- ✅ Bouton "Créer un match" visible uniquement pour admin -->
        <Button fx:id="createMatchButton" 
                text="+ Créer un match"
                onAction="#handleCreateMatch"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px;"/>
    </HBox>

    <!-- Table des matchs -->
    <TableView fx:id="matchTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="matchIdColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="team1Column" text="Équipe 1" prefWidth="200"/>
            <TableColumn fx:id="team2Column" text="Équipe 2" prefWidth="200"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="150"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200"/>
        </columns>
    </TableView>
</VBox>