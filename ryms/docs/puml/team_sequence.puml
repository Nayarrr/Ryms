@startuml
actor User
participant "TeamDashboard" as View
participant "TeamController" as Controller
participant "TeamFacade" as Facade
participant "TeamManager" as Manager
participant "TeamDAO" as DAO
database "PostgreSQL" as DB

== Create Team ==
User -> View : Click "Créer une équipe"
View -> View : Open Modal (CreateTeam.fxml)
User -> View : Enter Name, Tag, Description
User -> View : Click "Créer"
View -> Controller : createTeam(name, tag, ...)
activate Controller
Controller -> Facade : createTeam(...)
activate Facade
Facade -> Manager : createTeam(...)
activate Manager
Manager -> DAO : createTeam(...)
activate DAO
DAO -> DB : INSERT INTO teams ...
activate DB
DB --> DAO : Generated ID
deactivate DB
DAO -> DB : INSERT INTO team_members (Captain)
activate DB
DB --> DAO : OK
deactivate DB
DAO --> Manager : Team Object
deactivate DAO
Manager --> Facade : Team
deactivate Manager
Facade --> Controller : Team
deactivate Facade
Controller --> View : Success
deactivate Controller
View -> View : Close Modal & Refresh

== Invite Member ==
User -> View : Enter Email & Click "Inviter"
View -> Controller : inviteMember(teamId, myEmail, targetEmail)
activate Controller
Controller -> Facade : inviteMember(...)
activate Facade
Facade -> Manager : inviteMember(...)
activate Manager
Manager -> DAO : findUserByEmail(target)
activate DAO
DAO --> Manager : User found
deactivate DAO
Manager -> DAO : createInvitation(teamId, targetId)
activate DAO
DAO -> DB : INSERT INTO invitations ...
activate DB
DB --> DAO : OK
deactivate DB
DAO --> Manager : void
deactivate DAO
Manager --> Facade : void
deactivate Manager
Facade --> Controller : void
deactivate Facade
Controller --> View : Update UI "Invitation sent"
deactivate Controller
@enduml
