Facade -> Manager: getRegisteredTeamsCount(tournamentId)
activate Manager
Manager -> RegistrationDAO: getRegisteredTeamsCount(tournamentId)
activate RegistrationDAO
RegistrationDAO -> DB: SELECT COUNT(*) FROM tournament_registrations\nWHERE tournament_id = ?
activate DB
DB --> RegistrationDAO: count
deactivate DB
RegistrationDAO --> Manager: int (count)
deactivate RegistrationDAO
Manager --> Facade: int (count)
deactivate Manager
Facade --> User: int (count)
deactivate Facade

@enduml
