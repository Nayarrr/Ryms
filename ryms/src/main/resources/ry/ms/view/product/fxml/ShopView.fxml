<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ry.ms.view.product.ShopController"
            prefHeight="800.0" prefWidth="1200.0"
            stylesheets="@../../styles.css">
    <top>
        <VBox spacing="6" styleClass="header-section">
            <padding>
                <Insets top="18" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Boutique" styleClass="header-title"/>
            <Label text="Ajoutez des produits à votre panier" styleClass="subtitle-label"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <FlowPane fx:id="productsGrid" hgap="18" vgap="18" prefWrapLength="900" style="-fx-padding: 0 20 20 20;" />
            </content>
        </ScrollPane>
    </center>

    <right>
        <VBox spacing="12" prefWidth="360" styleClass="details-panel">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <Label text="Mon panier" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <TableView fx:id="basketTable" prefHeight="400" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="productCol" text="Produit" prefWidth="140" />
                    <TableColumn fx:id="qtyCol" text="Qté" prefWidth="60" />
                    <TableColumn fx:id="priceCol" text="Prix" prefWidth="80" />
                    <TableColumn fx:id="subtotalCol" text="Sous-total" prefWidth="100" />
                </columns>
            </TableView>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label text="Total:" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Label fx:id="totalLabel" text="0.00 €" styleClass="title-label, success-text" style="-fx-font-size: 20px;" />
            </HBox>
            <Button text="Vider le panier" onAction="#handleClearBasket" styleClass="button, danger-button" />
            <Button text="Payer (Stripe)" onAction="#handleCheckout" styleClass="button, success-button" maxWidth="Infinity"/>
            <Label fx:id="statusLabel" wrapText="true" styleClass="error-label" />
        </VBox>
    </right>
</BorderPane>
