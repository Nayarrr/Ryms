<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="550.0" spacing="25" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ry.ms.view.games.AddGameController">

    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <Text style="-fx-font-size: 24; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Ajouter un nouveau jeu" />

    <GridPane hgap="15" vgap="25">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
        </columnConstraints>

        <Label style="-fx-font-size: 14;" text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" prefHeight="45.0" promptText="Ex: Rocket League"
                   style="-fx-font-size: 14; -fx-padding: 10;"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-font-size: 14;" text="Éditeur :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="editorField" prefHeight="45.0" promptText="Ex: Psyonix"
                   style="-fx-font-size: 14; -fx-padding: 10;"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-size: 14;" text="Date de sortie :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <DatePicker fx:id="releaseDatePicker" maxWidth="Infinity" prefHeight="45.0"
                    style="-fx-font-size: 14;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-font-size: 14;" text="Logo :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <HBox alignment="CENTER_LEFT" spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="3">
            <Button onAction="#handleSelectLogo" prefHeight="40.0"
                    style="-fx-background-color: #bdc3c7; -fx-padding: 8 15; -fx-cursor: hand;" text="Choisir une image" />
            <Label fx:id="fileNameLabel" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-font-size: 13;" text="Aucun fichier" />
        </HBox>
        <rowConstraints>
            <RowConstraints minHeight="45.0" />
            <RowConstraints minHeight="45.0" />
            <RowConstraints minHeight="45.0" />
            <RowConstraints minHeight="45.0" />
        </rowConstraints>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" minHeight="20" />

    <HBox alignment="CENTER_RIGHT" spacing="20">
        <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 14; -fx-cursor: hand;" text="Annuler" />
        <Button onAction="#handleSave" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 12 30; -fx-background-radius: 5; -fx-cursor: hand;" text="Enregistrer le jeu" />
    </HBox>

</VBox>