@startuml
actor User
participant "ShopView" as View
participant "ShopController" as Controller
participant "BasketFacade" as Basket
participant "PaymentService" as Payment
participant "Stripe API" as Stripe

User -> View : Click "Payer (Stripe)"
View -> Controller : handleCheckout()
activate Controller
Controller -> Basket : calculateTotal()
activate Basket
Basket --> Controller : Total Amount
deactivate Basket

Controller -> View : Open Payment Modal
User -> View : Enter Card Details
User -> View : Click "Pay"
View -> Controller : processPayment()

Controller -> Payment : createPaymentIntent(amount, verify=true)
activate Payment
Payment -> Stripe : PaymentIntent.create(...)
activate Stripe
Stripe --> Payment : PaymentIntent (status=succeeded)
deactivate Stripe
Payment --> Controller : Success
deactivate Payment

Controller -> Basket : emptyBasket()
activate Basket
Basket --> Controller : Done
deactivate Basket
Controller -> View : Show "Paiement Réussi"
Controller -> View : Close Modal
deactivate Controller
@enduml
