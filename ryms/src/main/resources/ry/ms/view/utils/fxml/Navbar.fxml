<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane styleClass="navbar" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ry.ms.view.utils.NavbarController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
    <left>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <ImageView fitHeight="40.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@/images/logo.png" />
                </image>
            </ImageView>
            <!-- Navigation Links (Visible only when logged in) -->
            <HBox fx:id="navLinks" alignment="CENTER_LEFT" spacing="15.0" visible="false" managed="false">
                <Button text="Équipes" onAction="#handleTeamsClick" styleClass="text-button, nav-link"/>
                <Button text="Matchs" onAction="#handleMatchesClick" styleClass="text-button, nav-link"/>
                <Button text="Jeux" onAction="#handleGamesClick" styleClass="text-button, nav-link"/>
                <Button text="Tournois" onAction="#handleTournamentsClick" styleClass="text-button, nav-link"/>
                <Button text="Produits" onAction="#handleProductsClick" styleClass="text-button, nav-link"/>
                <Button text="Boutique" onAction="#handleShopClick" styleClass="text-button, nav-link"/>
                <Button text="Invitations" onAction="#handleInvitationsClick" styleClass="button, secondary-button"/>
            </HBox>
        </HBox>
    </left>
   <right>
      <javafx.scene.layout.StackPane BorderPane.alignment="CENTER">
         <!-- Auth Box (Login/Register) -->
         <HBox fx:id="authBox" alignment="CENTER_RIGHT" spacing="10.0">
             <children>
                 <Button onAction="#handleLogin" styleClass="button" text="Login" />
                 <Button onAction="#handleRegister" styleClass="button, primary-button" text="Register" />
             </children>
         </HBox>
         <!-- User Box (Profile/Logout) - Initially Hidden -->
         <HBox fx:id="userBox" alignment="CENTER_RIGHT" spacing="10.0" visible="false" managed="false">
             <children>
                 <javafx.scene.control.Label fx:id="userLabel" text="Hello, User" styleClass="label, bold-label"/>
                 <Button fx:id="adminButton" onAction="#handleAdmin" styleClass="button, warning-button" text="Admin" visible="false" managed="false"/>
                 <Button onAction="#handleProfile" styleClass="button" text="Profile" />
                 <Button onAction="#handleLogout" styleClass="button, danger-button" text="Logout" />
             </children>
         </HBox>
      </javafx.scene.layout.StackPane>
   </right>
</BorderPane>