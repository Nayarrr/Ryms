activate RegistrationDAO
RegistrationDAO -> DB: UPDATE tournament_registrations\nSET confirmed = true\nWHERE registration_id = ?
activate DB
DB --> RegistrationDAO: rows affected
deactivate DB
RegistrationDAO --> Manager: boolean (success)
deactivate RegistrationDAO
Manager --> Facade: boolean (success)
deactivate Manager
Facade --> User: boolean (success)
deactivate Facade

== Check if Team is Registered ==
User -> Facade: isTeamRegistered(tournamentId, teamId)
activate Facade
Facade -> Manager: isTeamRegistered(tournamentId, teamId)
activate Manager
Manager -> RegistrationDAO: isTeamRegistered(tournamentId, teamId)
activate RegistrationDAO
RegistrationDAO -> DB: SELECT COUNT(*) FROM tournament_registrations\nWHERE tournament_id = ? AND team_id = ?
activate DB
DB --> RegistrationDAO: count
deactivate DB
