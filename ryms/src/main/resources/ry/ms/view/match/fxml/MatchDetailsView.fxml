<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ry.ms.view.match.matchDetail.MatchDetailsController"
            fitToWidth="true"
            stylesheets="@../../styles.css"
            styleClass="edge-to-edge-scroll-pane">
    
    <VBox fx:id="rootContainer" 
          spacing="25"
          alignment="TOP_CENTER"
          style="-fx-padding: 30 40 40 40;">

        <!-- ========== BOUTON RETOUR + COMMENCER LE MATCH ========== -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button text="← Retour" 
                    onAction="#handleBackToList"
                    styleClass="button, secondary-button"/>
            
            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="startMatchButton" 
                    text="Commencer le match"
                    onAction="#handleStartMatch"
                    visible="false"
                    managed="false"
                    styleClass="button, primary-button"/>
        </HBox>

        <!-- ========== CONTENEUR PRINCIPAL ========== -->
        <VBox spacing="30"
              alignment="TOP_CENTER"
              styleClass="card"
              style="-fx-max-width: 1200;">

            <!-- ========== HEADER : TITRE DU MATCH ========== -->
            <VBox spacing="12" alignment="CENTER">
                <Label fx:id="matchTitleLabel" 
                       text="Chargement..."
                       styleClass="header-title"/>
                
                <!-- Date et heure avec bouton modification -->
                <HBox spacing="15" alignment="CENTER">
                    <Label fx:id="matchDateLabel" 
                           text="Date : ..."
                           styleClass="subtitle-label"/>
                    
                    <Button fx:id="editDateButton" 
                            text="Modifier"
                            onAction="#handleEditDate"
                            visible="false"
                            managed="false"
                            styleClass="button, warning-button"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- ========== SECTION ARBITRES ========== -->
            <VBox spacing="15" alignment="CENTER">
                <HBox alignment="CENTER" spacing="20">
                    <Label text="Arbitres" 
                           styleClass="title-label"/>
                    
                    <Button fx:id="addRefereeButton" 
                            text="+ Ajouter"
                            onAction="#handleAddReferee"
                            visible="false"
                            managed="false"
                            styleClass="button, secondary-button"/>
                </HBox>

                <VBox fx:id="refereesListContainer" 
                      spacing="10" 
                      alignment="CENTER"
                      style="-fx-padding: 5 0 0 0;"/>
            </VBox>

            <Separator/>

            <!-- ========== SECTION SCORES ========== -->
            <VBox fx:id="scoresContainer"
                  spacing="18" 
                  alignment="CENTER"
                  style="-fx-padding: 0;">
            </VBox>

            <Separator/>

            <!-- ========== SECTION COMPOSITIONS DES ÉQUIPES ========== -->
            <VBox spacing="25" alignment="CENTER">
                <Label text="Compositions des équipes" 
                       styleClass="header-title"/>
                
                <HBox spacing="30" alignment="CENTER">
                    
                    <!-- ===== ÉQUIPE 1 ===== -->
                    <VBox spacing="18" 
                          fx:id="team1Box"
                          styleClass="card"
                          style="-fx-padding: 25; -fx-pref-width: 420; -fx-min-height: 450;">
                        
                        <!-- Nom de l'équipe -->
                        <Label fx:id="team1NameLabel" 
                               text="Équipe 1"
                               styleClass="title-label"
                               style="-fx-alignment: center;"/>
                        
                        <Separator/>
                        
                        <!-- Section Roster -->
                        <VBox spacing="12" VBox.vgrow="ALWAYS">
                            <Label text="Roster" 
                                   styleClass="subtitle-label"
                                   style="-fx-font-weight: bold;"/>
                            
                            <VBox fx:id="team1RosterContainer" 
                                  spacing="10"
                                  style="-fx-padding: 8 0 0 15;"/>
                        </VBox>
                        
                        <Separator/>
                        
                        <!-- Footer : Coach + Bouton Update -->
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <Label fx:id="team1CoachLabel" 
                                   text="Coach : ..."
                                   styleClass="subtitle-label"
                                   HBox.hgrow="ALWAYS"/>
                            
                            <Button fx:id="team1UpdateButton" 
                                    text="Update"
                                    onAction="#handleUpdateRosterTeam1"
                                    visible="false"
                                    managed="false"
                                    styleClass="button, warning-button"/>
                        </HBox>
                    </VBox>

                    <!-- ===== ÉQUIPE 2 ===== -->
                    <VBox spacing="18" 
                          fx:id="team2Box"
                          styleClass="card"
                          style="-fx-padding: 25; -fx-pref-width: 420; -fx-min-height: 450;">
                        
                        <!-- Nom de l'équipe -->
                        <Label fx:id="team2NameLabel" 
                               text="Équipe 2"
                               styleClass="title-label"
                               style="-fx-alignment: center;"/>
                        
                        <Separator/>
                        
                        <!-- Section Roster -->
                        <VBox spacing="12" VBox.vgrow="ALWAYS">
                            <Label text="Roster" 
                                   styleClass="subtitle-label"
                                   style="-fx-font-weight: bold;"/>
                            
                            <VBox fx:id="team2RosterContainer" 
                                  spacing="10"
                                  style="-fx-padding: 8 0 0 15;"/>
                        </VBox>
                        
                        <Separator/>
                        
                        <!-- Footer : Coach + Bouton Update -->
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <Label fx:id="team2CoachLabel" 
                                   text="Coach : ..."
                                   styleClass="subtitle-label"
                                   HBox.hgrow="ALWAYS"/>
                            
                            <Button fx:id="team2UpdateButton" 
                                    text="Update"
                                    onAction="#handleUpdateRosterTeam2"
                                    visible="false"
                                    managed="false"
                                    styleClass="button, warning-button"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>

    </VBox>
</ScrollPane>