<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Carte de match cliquable (Style Dark Esport) -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:id="matchCard"
      spacing="12"
      style="-fx-background-color: linear-gradient(to bottom right, #1a1f3a, #0f1429); 
             -fx-background-radius: 12; 
             -fx-border-color: #2a3f5f; 
             -fx-border-width: 1; 
             -fx-border-radius: 12; 
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 4); 
             -fx-cursor: hand; 
             -fx-pref-width: 700; 
             -fx-max-width: 800;">
    
    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <!-- ========== HEADER : Heure + Date + Statut + Bouton Supprimer ========== -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="matchTimeLabel" 
               text="20:00" 
               style="-fx-font-size: 20px; 
                      -fx-font-weight: bold; 
                      -fx-text-fill: #5bc0eb; 
                      -fx-effect: dropshadow(gaussian, rgba(91,192,235,0.6), 5, 0, 0, 0);"/>
        
        <Label fx:id="matchDateLabel" 
               text="Samedi 04 Jan" 
               style="-fx-font-size: 14px; 
                      -fx-text-fill: #8b95a5; 
                      -fx-font-style: italic;"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Label fx:id="matchStatusLabel" 
               text="À VENIR" 
               style="-fx-font-size: 12px; 
                      -fx-font-weight: bold; 
                      -fx-text-fill: #ffc857; 
                      -fx-background-color: rgba(255,200,87,0.15); 
                      -fx-background-radius: 8; 
                      -fx-padding: 5 15 5 15; 
                      -fx-border-color: #ffc857; 
                      -fx-border-width: 1; 
                      -fx-border-radius: 8;"/>
        
        <Button fx:id="deleteButton" 
                text="🗑️"
                visible="false"
                managed="false"
                style="-fx-background-color: transparent; 
                       -fx-text-fill: #ff6b6b; 
                       -fx-font-size: 18px; 
                       -fx-cursor: hand; 
                       -fx-padding: 5 10 5 10; 
                       -fx-background-radius: 8;"/>
    </HBox>

    <!-- Séparateur -->
    <Region style="-fx-background-color: #2a3f5f; -fx-pref-height: 1; -fx-opacity: 0.5;"/>

    <!-- ========== CORPS : Team1 VS Team2 ========== -->
    <HBox spacing="40" alignment="CENTER">
        
        <!-- ===== TEAM 1 ===== -->
        <VBox spacing="10" alignment="CENTER" prefWidth="200">
            <ImageView fx:id="team1Logo" 
                       fitWidth="70" 
                       fitHeight="70" 
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 8, 0, 0, 2);"/>
            
            <Label fx:id="team1NameLabel" 
                   text="GentleMates" 
                   style="-fx-font-size: 18px; 
                          -fx-font-weight: bold; 
                          -fx-text-fill: white; 
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 3, 0, 0, 1);"/>
            
            <Label fx:id="team1TagLabel" 
                   text="[M16]" 
                   style="-fx-font-size: 13px; 
                          -fx-text-fill: #8b95a5; 
                          -fx-font-style: italic;"/>
        </VBox>

        <!-- ===== VS / SCORE ===== -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="VS" 
                   style="-fx-font-size: 28px; 
                          -fx-font-weight: bold; 
                          -fx-text-fill: #ffc857; 
                          -fx-effect: dropshadow(gaussian, rgba(255,200,87,0.8), 10, 0, 0, 0);"/>
            
            <Label fx:id="scoreLabel" 
                   text="0 - 0" 
                   visible="false"
                   style="-fx-font-size: 18px; 
                          -fx-font-weight: bold; 
                          -fx-text-fill: #5bc0eb;"/>
        </VBox>

        <!-- ===== TEAM 2 ===== -->
        <VBox spacing="10" alignment="CENTER" prefWidth="200">
            <ImageView fx:id="team2Logo" 
                       fitWidth="70" 
                       fitHeight="70" 
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 8, 0, 0, 2);"/>
            
            <Label fx:id="team2NameLabel" 
                   text="Karmine Corp" 
                   style="-fx-font-size: 18px; 
                          -fx-font-weight: bold; 
                          -fx-text-fill: white; 
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 3, 0, 0, 1);"/>
            
            <Label fx:id="team2TagLabel" 
                   text="[KCB]" 
                   style="-fx-font-size: 13px; 
                          -fx-text-fill: #8b95a5; 
                          -fx-font-style: italic;"/>
        </VBox>
    </HBox>

    <!-- Séparateur -->
    <Region style="-fx-background-color: #2a3f5f; -fx-pref-height: 1; -fx-opacity: 0.5;"/>

    <!-- ========== FOOTER : Compétition + Format ========== -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label fx:id="competitionLabel" 
               text="Nom du Tournoi (a faire quand on aura mis en place cela)" 
               style="-fx-font-size: 12px; 
                      -fx-font-weight: bold; 
                      -fx-text-fill: #5bc0eb;"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- Pour l'instant fix je n'ai pas cela en place, donc full BO1--> 
        <Label fx:id="formatLabel" 
               text="BO1" 
               style="-fx-font-size: 11px; 
                      -fx-text-fill: #8b95a5; 
                      -fx-background-color: rgba(139,149,165,0.15); 
                      -fx-background-radius: 6; 
                      -fx-padding: 4 12 4 12; 
                      -fx-border-color: #8b95a5; 
                      -fx-border-width: 1; 
                      -fx-border-radius: 6;"/>
    </HBox>
</VBox>