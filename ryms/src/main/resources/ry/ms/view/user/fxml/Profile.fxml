<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ry.ms.view.user.profile.ProfileController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="User Profile">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <TextField fx:id="emailField" editable="false" promptText="Email" style="-fx-background-color: #f0f0f0;" />
    <TextField fx:id="usernameField" promptText="Username" />
    <PasswordField fx:id="passwordField" promptText="New Password (leave empty to keep current)" />

    <Label fx:id="messageLabel" text="" />

    <Button onAction="#handleUpdate" text="Update Profile" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" maxWidth="Infinity"/>
    
    <Button onAction="#handleChangePassword" text="Change Password" maxWidth="Infinity" />

    <HBox spacing="10" alignment="CENTER">
        <Button onAction="#handleBack" text="Back to Dashboard" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button onAction="#handleDelete" text="Deactivate Account" style="-fx-background-color: #f44336; -fx-text-fill: white;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>
