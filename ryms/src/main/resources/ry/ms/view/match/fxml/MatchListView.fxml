<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ry.ms.view.match.MatchListViewController"
      spacing="20"
      style="-fx-background-color: #0a0e27;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- ========== EN-TÊTE ========== -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Prochains Matchs" 
               style="-fx-font-size: 34px; 
                      -fx-font-weight: bold; 
                      -fx-text-fill: white; 
                      -fx-effect: dropshadow(gaussian, rgba(91,192,235,0.5), 8, 0, 0, 2);"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button fx:id="createMatchButton" 
                text="+ Créer un match"
                onAction="#handleCreateMatch"
                style="-fx-background-color: linear-gradient(to bottom right, #4ecca3, #3a9b7f); 
                       -fx-text-fill: white; 
                       -fx-font-size: 15px; 
                       -fx-font-weight: bold;  
                       -fx-padding: 14 28 14 28; 
                       -fx-background-radius: 8; 
                       -fx-cursor: hand; 
                       -fx-effect: dropshadow(gaussian, rgba(78,204,163,0.5), 8, 0, 0, 3);"/>
    </HBox>

    <!-- Séparateur -->
    <Region style="-fx-background-color: #2a3f5f; -fx-pref-height: 2;"/>

    <!-- ========== CONTAINER DES CARTES (avec ScrollPane) ========== -->
    <ScrollPane fitToWidth="true" 
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; 
                       -fx-background: transparent;">
        
        <VBox fx:id="matchesContainer" 
              spacing="18" 
              alignment="TOP_CENTER"
              style="-fx-background-color: #0a0e27;">
            
            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>
        </VBox>
    </ScrollPane>
</VBox>