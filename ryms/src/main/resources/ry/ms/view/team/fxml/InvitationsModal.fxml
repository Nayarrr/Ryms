<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ry.ms.view.team.InvitationsController"
      spacing="10" 
      prefWidth="400" prefHeight="300"
      stylesheets="@../../styles.css"
      styleClass="card">

    <Label text="Invitations en attente" styleClass="title-label"/>
    
    <ListView fx:id="invitationListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
    
    <HBox spacing="10" alignment="CENTER">
        <Button text="Accepter" onAction="#handleAccept" styleClass="button, success-button"/>
        <Button text="Refuser" onAction="#handleReject" styleClass="button, danger-button"/>
    </HBox>
    
    <Label fx:id="statusLabel" styleClass="subtitle-label"/>
</VBox>
