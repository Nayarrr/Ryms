<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Carte de match cliquable -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="matchCard"
      spacing="12"
      styleClass="card"
      stylesheets="@../../styles.css"
      maxWidth="800" prefWidth="700">
    
    <!-- ========== HEADER : Heure + Date + Statut + Bouton Supprimer ========== -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="matchTimeLabel" 
               text="20:00" 
               styleClass="title-label"
               style="-fx-font-size: 20px;"/>
        
        <Label fx:id="matchDateLabel" 
               text="Samedi 04 Jan" 
               styleClass="subtitle-label"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <!-- Badge SCHEDULED -->
        <Label fx:id="statusScheduled" 
               text="À VENIR"
               styleClass="status-badge, status-planning"/>
        
        <!-- Badge IN_PROGRESS -->
        <Label fx:id="statusInProgress" 
               text="En COURS"
               visible="false"
               managed="false"
               styleClass="status-badge, status-in_progress"/>
        
        <!-- Badge FINISHED -->
        <Label fx:id="statusFinished" 
               text="TERMINÉ"
               visible="false"
               managed="false"
               styleClass="status-badge, status-completed"/>
        
        <Button fx:id="deleteButton" 
                text="🗑️"
                visible="false"
                managed="false"
                styleClass="button, transparent-button"
                style="-fx-text-fill: #e74c3c;"/>
    </HBox>

    <Separator/>

    <!-- ========== CORPS : Team1 VS Team2 ========== -->
    <HBox spacing="40" alignment="CENTER">
        
        <!-- ===== TEAM 1 ===== -->
        <VBox spacing="10" alignment="CENTER" prefWidth="200">
            <ImageView fx:id="team1Logo" 
                       fitWidth="70" 
                       fitHeight="70" 
                       preserveRatio="true"/>
            
            <Label fx:id="team1NameLabel" 
                   text="GentleMates" 
                   styleClass="title-label"
                   style="-fx-font-size: 18px;"/>
            
            <Label fx:id="team1TagLabel" 
                   text="[M16]" 
                   styleClass="subtitle-label"/>
        </VBox>

        <!-- ===== VS / SCORE ===== -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="VS" 
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f1c40f;"/>
            
            <Label fx:id="scoreLabel" 
                   text="0 - 0" 
                   visible="false"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        </VBox>

        <!-- ===== TEAM 2 ===== -->
        <VBox spacing="10" alignment="CENTER" prefWidth="200">
            <ImageView fx:id="team2Logo" 
                       fitWidth="70" 
                       fitHeight="70" 
                       preserveRatio="true"/>
            
            <Label fx:id="team2NameLabel" 
                   text="Karmine Corp" 
                   styleClass="title-label"
                   style="-fx-font-size: 18px;"/>
            
            <Label fx:id="team2TagLabel" 
                   text="[KCB]" 
                   styleClass="subtitle-label"/>
        </VBox>
    </HBox>

    <Separator/>

    <!-- ========== FOOTER : Compétition + Format ========== -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label fx:id="competitionLabel" 
               text="Nom du Tournoi" 
               styleClass="subtitle-label"
               style="-fx-font-weight: bold;"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Label fx:id="formatLabel" 
               text="BO1"  
               style="-fx-background-color: #f8f9fa; -fx-padding: 4 12; -fx-background-radius: 6; -fx-text-fill: #7f8c8d;"/>
    </HBox>
</VBox>