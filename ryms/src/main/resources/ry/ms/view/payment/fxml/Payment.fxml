<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" 
      stylesheets="@../../styles.css"
      styleClass="card"
      style="-fx-max-width: 500;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ry.ms.view.payment.PaymentController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Secure Payment" styleClass="header-title" />

    <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="300">
        <Label text="Amount to Pay" styleClass="subtitle-label"/>
        <Label fx:id="amountLabel" text="\$0.00" styleClass="title-label"/>
    </VBox>

    <VBox spacing="10" maxWidth="300">
        <Label text="Card Details (Test Mode)" styleClass="subtitle-label"/>
        <TextField fx:id="cardNumberField" promptText="Card Number (4242 4242 4242 4242)" styleClass="text-field"/>
        <TextField fx:id="expiryField" promptText="MM/YY" styleClass="text-field"/>
        <TextField fx:id="cvcField" promptText="CVC" styleClass="text-field"/>
    </VBox>

    <Label fx:id="statusLabel" text="" styleClass="error-label" wrapText="true" maxWidth="300"/>

    <Button fx:id="payButton" text="Pay Now" onAction="#handlePayment" 
            styleClass="button, success-button" maxWidth="300"/>
    
    <Button text="Cancel" onAction="#handleCancel" maxWidth="300" styleClass="button, secondary-button"/>

</VBox>
