<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ry.ms.view.match.MatchListViewController"
      spacing="0"
      stylesheets="@../../styles.css">

    <!-- ========== EN-TÊTE ========== -->
    <VBox spacing="6" styleClass="header-section">
        <padding>
            <Insets top="18" right="20" bottom="12" left="20"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Prochains Matchs" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="createMatchButton" 
                    text="+ Créer un match"
                    onAction="#handleCreateMatch"
                    styleClass="button, primary-button"/>
        </HBox>
    </VBox>

    <!-- ========== CONTAINER DES CARTES (avec ScrollPane) ========== -->
    <ScrollPane fitToWidth="true" 
                VBox.vgrow="ALWAYS"
                styleClass="edge-to-edge-scroll-pane">
        
        <VBox fx:id="matchesContainer" 
              spacing="18" 
              alignment="TOP_CENTER"
              style="-fx-padding: 20;">
        </VBox>
    </ScrollPane>
</VBox>